# AI / Agent configs
# Per-user local dirs stay ignored (personal cache / local overrides).
/.claude/
/.claude-flow/
/.opencode/
/.agents/
/.cursor/
/.copilot*
/.github/copilot*
# Keep shared skill rules under .ai/rules; ignore other .ai scratch.
/*.ai
!/.ai/
/.ai/*
!/.ai/rules/
# Personal agent-local startup/override files are local.
/agent*
/claude*
/opencode*
# Project-level agent config + instructions are NOT personal: track them so a
# fresh clone gets the skills, instructions, and MCP wiring. /opencode* above
# ignores the local/global opencode.jsonc form; /opencode.json rescues the
# repo-root project config only.  /agent* ignores AGENT.md, so negate it back.
!/opencode.json
!/AGENTS.md
!/AGENT.md

# Agent / vector databases
/.swarm/
/ruvector.db

# Internal specs (not the main docs)
/docs/superpowers/

# Deepwork session tracking
/.slim/deepwork/

# Sensitive / local
/.env.*
/docker-compose.override.yml
/docker-compose.override.yaml
/scripts/local*
/config/local*

# Playwright test output
/test-results/

# Stray empty file
/null
